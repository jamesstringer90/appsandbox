// A version well above any NVIDIA release so dxgkrnl's CopyToVmWhenNewer
// staging never replaces the deployed proxy with NVIDIA's stub on boot.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    99,0,0,0
 PRODUCTVERSION 99,0,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "AppSandbox"
            VALUE "FileDescription",  "AppSandbox NVAPI forwarding proxy for GPU-PV guests"
            VALUE "FileVersion",      "99.0.0.0"
            VALUE "InternalName",     "nvapi64"
            VALUE "OriginalFilename", "nvapi64.dll"
            VALUE "ProductName",      "AppSandbox"
            VALUE "ProductVersion",   "99.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
